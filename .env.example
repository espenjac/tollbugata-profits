# Legacy Python-oppsett. V2-frontenden bruker web/.env.example.
# Kopier til .env og fyll inn egne verdier. .env er gitignorert.
# Bruk et langt passord og en lang, tilfeldig hemmelighet.
TP_PASSWORD=bytt-meg
TP_SECRET=lag-en-lang-tilfeldig-hemmelighet
# Sett til 1 når appen ligger bak HTTPS.
TP_SECURE_COOKIES=0
